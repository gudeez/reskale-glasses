{
  "name": "reskale",
  "type": "commonjs",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "expo": {
    "install": {
      "//": "React Navigation is intentionally AHEAD of the versions SDK 54 pins. 7.9.3 / 7.1.28 both satisfy Expo's own ranges (^7.5.0 / ^7.1.8) — expo-doctor compares the range STRING, not the resolved version, so it reports a false mismatch. Excluding keeps `npx expo-doctor` green without downgrading working packages.",
      "exclude": [
        "@react-navigation/drawer",
        "@react-navigation/native"
      ]
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "start:dev": "set APP_VARIANT=development&& expo start --dev-client",
    "dev": "adb reverse tcp:8081 tcp:8081 && set APP_VARIANT=development&& expo start --dev-client",
    "devnet:phone": "node devnet/phone.mjs",
    "android": "expo run:android",
    "android:dev": "set APP_VARIANT=development&& expo run:android",
    "build:dev:android": "eas build --profile development --platform android",
    "ios": "expo run:ios",
    "ios:dev": "set APP_VARIANT=development&& expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:revenuecat": "node scripts/test-revenuecat-webhook.cjs",
    "test:authenticate": "node scripts/test-authenticate.cjs",
    "devnet:sim": "vitest run --config vitest.devnet.mts",
    "devnet:sim:watch": "vitest --config vitest.devnet.mts",
    "devnet:check": "vitest run --config vitest.devnet.mts devnet/scenarios/rls.scenario.ts"
  },
