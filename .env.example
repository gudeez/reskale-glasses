# Meta Model API key (dev.meta.ai). Muse identifies the item, writes the
# eBay search and answers spoken questions.
MODEL_API_KEY=

# Hard cap on Muse spend, in US dollars. Calls stop once it is reached.
MUSE_BUDGET_USD=150

# eBay Browse API (developer.ebay.com, production keyset): asking prices.
EBAY_APP_ID=
EBAY_CERT_ID=

# ScrapeBadger (scrapebadger.com): eBay sold listings for the buy/pass rules.
SCRAPEBADGER_API_KEY=

# Where the phone reaches this app's API routes. Metro serves them in
# development, so leave it empty unless the API runs somewhere else.
EXPO_PUBLIC_API_URL=
